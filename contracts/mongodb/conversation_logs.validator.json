{
  "collection": "conversation_logs",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "tenant_id",
        "channel",
        "recipient",
        "message_body",
        "direction",
        "status",
        "created_at"
      ],
      "properties": {
        "tenant_id": { "bsonType": "string" },
        "appointment_id": { "bsonType": "string" },
        "channel": { "enum": ["WHATSAPP", "EMAIL", "SMS"] },
        "recipient": { "bsonType": "string" },
        "message_body": { "bsonType": "string" },
        "direction": { "enum": ["INBOUND", "OUTBOUND"] },
        "status": { "enum": ["QUEUED", "SENT", "DELIVERED", "FAILED"] },
        "trace_id": { "bsonType": "string" },
        "created_at": { "bsonType": "date" }
      }
    }
  },
  "indexes": [
    { "keys": { "tenant_id": 1, "created_at": -1 } }
  ]
}
