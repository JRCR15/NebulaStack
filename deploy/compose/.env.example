POSTGRES_USER=nebulastack
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=nebulastack
# App services use nebulastack_app (created in contracts/sql/006_app_role.sql)
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_ISSUER=https://auth.nebulastack.local
JWT_AUDIENCE=nebulastack-api
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
MONGO_URL=mongodb://mongo:27017/nebulastack
MOCK_GATEWAY_URL=http://external-mocks:8090
HOLD_TTL_SECONDS=120
RATE_LIMIT_RPS=100
